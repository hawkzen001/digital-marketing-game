rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && (request.auth.token.email == '001nilesh.sharma@gmail.com' || (request.auth.uid == userId && (resource == null || !('banned' in resource.data) || resource.data.banned == false)));
    }
    match /pitches/{pitchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
